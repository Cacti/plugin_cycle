#: setup.php
msgid "Custom Graph List"
msgstr "कस्टम ग्राफ़ सूची"

#: setup.php
msgid "This must be a comma delimited list of Graph ID's to cycle through. For example '1,2,3,4'"
msgstr "यह ग्राफ आईडी की एक अल्पविराम सीमांकित सूची होनी चाहिए। उदाहरण के लिए '1,2,3,4'"

#: setup.php
msgid "Default Tree"
