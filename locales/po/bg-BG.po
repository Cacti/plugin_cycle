msgid "Custom Graph List"
msgstr "Потребителски списък с графики"

#: setup.php
msgid "This must be a comma delimited list of Graph ID's to cycle through. For example '1,2,3,4'"
msgstr "Това трябва да е списък с разделени със запетая идентификатори на графиките, през които да преминавате. Например „1,2,3,4“"

#: setup.php
msgid "Default Tree"
msgstr "Дърво по подразбиране"

#: setup.php
msgid "Select the graph tree to cycle if Tree Mode is selected"
