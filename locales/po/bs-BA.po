#: setup.php
msgid "Specific List"
msgstr "Određena lista"

#: setup.php
msgid "Tree Mode"
msgstr "Režim stabla"

#: setup.php
msgid "Custom Graph List"
msgstr "Prilagođena lista grafikona"

#: setup.php
msgid "This must be a comma delimited list of Graph ID's to cycle through. For example '1,2,3,4'"
msgstr "Ovo mora biti zarezom odvojena lista ID-jeva grafikona kroz koje se kruži. Na primjer '1,2,3,4'"

#: setup.php
msgid "Default Tree"
msgstr "Podrazumijevano stablo"

