msgid "Cycle Graphs"
msgstr "Izmjenjivanje grafikona"

#: includes/functions.php setup.php
#, php-format
msgid "%d Graph"
msgstr "%d grafikon"

#: includes/functions.php setup.php
#, php-format
msgid "%d Graphs"
msgstr "%d grafikona"

#: includes/functions.php setup.php
#, php-format
msgid "%d Column"
msgstr "%d stupac"

