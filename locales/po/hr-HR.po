msgid "Plugin -> Cycle Graphs"
msgstr "Dodatak -> Izmjenjivanje grafikona"

#: setup.php
msgid "Cycle"
msgstr "Izmjena"

#: setup.php
msgid "Delay Interval"
msgstr "Interval odgode"

#: setup.php
msgid "This is the time in seconds before the next graph is displayed."
msgstr "Ovo je vrijeme u sekundama prije prikaza sljedećeg grafikona."

#: setup.php
msgid "Graph Timespan"
msgstr "Vremenski raspon grafikona"

#: setup.php
msgid "This is the default timespan that will be displayed on the page."
msgstr "Ovo je zadani vremenski raspon koji će se prikazivati na stranici."

#: setup.php
msgid "Column Count"
msgstr "Broj stupaca"

#: setup.php
msgid "In Tree Mode this is the number of columns that will be used."
msgstr "U načinu stabla ovo je broj stupaca koji će se koristiti."

#: setup.php
msgid "Select the number of graphs to display per page"
msgstr "Odaberite broj grafikona za prikaz po stranici"

#: setup.php
msgid "This sets the graph height for the displayed graphs."
msgstr "Ovim se postavlja visina prikazanih grafikona."

#: setup.php
msgid "This sets the graph width for the displayed graphs."
msgstr "Ovim se postavlja širina prikazanih grafikona."

#: setup.php
msgid "Display Legend"
msgstr "Prikaži legendu"

#: setup.php
msgid "Check this to display legend."
msgstr "Označite ovo za prikaz legende."

#: setup.php
msgid "Predefined Rotations"
msgstr "Unaprijed definirane rotacije"

#: setup.php
msgid "Rotation Type"
msgstr "Vrsta rotacije"

#: setup.php
msgid "Select which method to use for custom graph rotation.  If you select 'Specific List', you must define a list of Graph ID's"
msgstr "Odaberite metodu koja će se koristiti za prilagođenu rotaciju grafikona. Ako odaberete 'Određeni popis', morate definirati popis ID-ova grafikona"

#: setup.php
msgid "Legacy (All)"
msgstr "Naslijeđeno (Sve)"

#: setup.php
msgid "Specific List"
msgstr "Određeni popis"

#: setup.php
msgid "Tree Mode"
msgstr "Način stabla"

#: setup.php
msgid "Custom Graph List"
msgstr "Prilagođeni popis grafikona"

#: setup.php
msgid "This must be a comma delimited list of Graph ID's to cycle through. For example '1,2,3,4'"
msgstr "Ovo mora biti zarezom odvojen popis ID-ova grafikona kroz koje se izmjenjuje. Na primjer '1,2,3,4'"

#: setup.php
msgid "Default Tree"
msgstr "Zadano stablo"

#: setup.php
msgid "Select the graph tree to cycle if Tree Mode is selected"
msgstr "Odaberite stablo grafikona za izmjenjivanje ako je odabran način stabla"

